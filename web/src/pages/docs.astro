---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { repo, releasesLatest } from "../data/site";

// The grid is the page inventory. Adding a file under the repo's docs/ puts a
// card here with no edit to this page — see src/content.config.ts.
const pages = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order
);

// One flat grid rather than a section per category: the pill on each card
// already names the category, and `order` groups them by it anyway. Headings
// would repeat the pill and leave a half-empty row under every one.
const hues: Record<string, string> = {
  "Getting started": "chip--green",
  Guides: "chip--cyan",
  Reference: "chip--purple",
};

const popular = ["install", "features", "cli", "reading"]
  .map((id) => pages.find((p) => p.id === id))
  .filter((p) => p !== undefined);

const steps = [
  {
    title: "Install the app",
    body: "Homebrew, or the DMG from the latest release. The first launch needs one right-click → <strong>Open</strong>.",
  },
  {
    title: "Add a folder",
    body: "Press <kbd>⇧⌘A</kbd> or drop a folder onto the window. Add as many roots as you like — local, over SSH, or a git clone.",
  },
  {
    title: "Open a file",
    body: "Click it in the sidebar, or find it anywhere across your roots with Quick Open (<kbd>⌘P</kbd>).",
  },
  {
    title: "Install the CLI",
    body: `<strong>File → Install <code class="tok">reader</code> Command Line Tool…</strong>, and <code class="tok">reader .</code> opens the folder you are in.`,
  },
];
---

<Base title="Docs — Reader.md" page="docs">
  <div class="hub">
    <header class="hub__hero">
      <div class="pill hub__eyebrow">Documentation</div>
      <h1 class="hub__title">Reader.md documentation</h1>
      <p class="hub__lead">
        Install it, learn the keys, and read one page per feature area — each
        with screenshots taken from the running app.
      </p>

      <div class="filter">
        <svg class="filter__icon" viewBox="0 0 24 24" width="17" height="17" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="docfilter"
          class="filter__input"
          type="search"
          autocomplete="off"
          placeholder={`Filter ${pages.length} pages…`}
          aria-label="Filter documentation pages"
        />
      </div>

      <div class="hub__popular">
        <span class="hub__popularlabel">Popular:</span>
        {popular.map((p) => (
          <a href={`/docs/${p.id}`} class="pill hub__chip">{p.data.title}</a>
        ))}
      </div>
    </header>

    <section class="start card" data-hidewhenfiltering>
      <div class="start__head">
        <div>
          <div class="pill hub__eyebrow">New to Reader.md?</div>
          <h2 class="start__title">Start here — set up in 4 steps</h2>
        </div>
        <a href="/docs/install" class="start__all">Full install guide →</a>
      </div>
      <ol class="start__steps">
        {steps.map((s, i) => (
          <li class="step">
            <div class="step__n">{i + 1}</div>
            <div class="step__title">{s.title}</div>
            <p class="step__body" set:html={s.body} />
          </li>
        ))}
      </ol>
    </section>

    <section class="browse">
      <h2 class="browse__title" data-hidewhenfiltering>
        Every page, by what you're doing
      </h2>

      <div class="browse__grid">
        {pages.map((p) => (
          <a
            href={`/docs/${p.id}`}
            class="dcard card"
            data-card
            data-search={`${p.data.title} ${p.data.summary} ${p.data.category}`.toLowerCase()}
          >
            <span class:list={["chip", "dcard__tag", hues[p.data.category]]}>
              {p.data.category}
            </span>
            <span class="dcard__title">{p.data.title}</span>
            <span class="dcard__summary">{p.data.summary}</span>
          </a>
        ))}
      </div>

      <p class="browse__empty" data-empty hidden>
        No page matches that. Try the <a href={`${repo}/issues`}>issue tracker</a>,
        or the app's own help — <strong>Help → FAQ</strong>.
      </p>
    </section>

    <footer class="hub__foot" data-hidewhenfiltering>
      <a href={releasesLatest} class="btn btn--primary">Download Reader.md</a>
      <a href="/changelog" class="btn btn--ghost">See what's new →</a>
      <a href={repo} class="btn btn--ghost">GitHub ↗</a>
    </footer>
  </div>
</Base>

<script>
  // Nine-ish pages: a filter, not a search index. Matching is a plain substring
  // over title, summary, and category, and everything that is not a card is
  // hidden while the field has text so the results are the whole page.
  const input = document.querySelector<HTMLInputElement>("#docfilter");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"));
  const chrome = Array.from(document.querySelectorAll<HTMLElement>("[data-hidewhenfiltering]"));
  const empty = document.querySelector<HTMLElement>("[data-empty]");

  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let hits = 0;
    for (const card of cards) {
      const match = !q || (card.dataset.search ?? "").includes(q);
      card.hidden = !match;
      if (match) hits++;
    }
    for (const el of chrome) el.hidden = q.length > 0;
    if (empty) empty.hidden = hits > 0;
  });
</script>

<style>
  .hub {
    position: relative;
    z-index: 2;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: calc(var(--nav-h) + 56px) var(--pad-x) 96px;
  }

  /* Hero ------------------------------------------------------------------ */
  .hub__hero {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 64px;
  }

  .hub__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 6px 14px;
  }

  .hub__title {
    margin: 20px 0 16px;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .hub__lead {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }

  .filter {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .filter:focus-within {
    border-color: oklch(0.72 0.16 260 / 0.45);
  }

  .filter__icon {
    flex: none;
    color: var(--faint);
  }

  .filter__input {
    flex: 1;
    min-width: 0;
    padding: 14px 0;
    border: none;
    background: none;
    color: var(--fg);
    font-family: inherit;
    font-size: 15px;
  }

  .filter__input::placeholder {
    color: var(--faint);
  }

  .filter__input:focus {
    outline: none;
  }

  .hub__popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }

  .hub__popularlabel {
    font-size: 13px;
    color: var(--faint);
    margin-right: 4px;
  }

  .hub__chip {
    padding: 6px 13px;
    font-size: 13px;
  }

  .hub__chip:hover {
    color: var(--fg);
    background: var(--surface-3);
  }

  /* Start here ------------------------------------------------------------ */
  .start {
    padding: 28px;
    margin-bottom: 72px;
  }

  .start__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .start__title {
    margin: 14px 0 0;
    font-size: 27px;
    letter-spacing: -0.025em;
  }

  .start__all {
    font-size: 14px;
    white-space: nowrap;
  }

  .start__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step {
    position: relative;
    padding: 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
  }

  /* Chevron between cards, echoing the flow of the four steps. Decorative, so
     it is dropped rather than rotated once the grid stacks. */
  .step:not(:last-child)::after {
    content: "›";
    position: absolute;
    top: 50%;
    right: -12px;
    translate: 0 -50%;
    z-index: 1;
    font-size: 18px;
    line-height: 1;
    color: var(--faint);
  }

  .step__n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-bottom: 14px;
    border-radius: 999px;
    background: var(--surface-3);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .step__title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .step__body {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--faint);
  }

  .step__body :global(kbd) {
    font-size: 12px;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--surface-3);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  /* Browse ---------------------------------------------------------------- */
  .browse__title {
    margin: 0 0 36px;
    font-size: 30px;
    letter-spacing: -0.03em;
    text-align: center;
  }

  .browse__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
    gap: 14px;
  }

  .dcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    color: inherit;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .dcard:hover {
    color: inherit;
    background: var(--surface-2);
    border-color: var(--border);
  }

  .dcard__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  /* Categories with no hue class still need a readable neutral. */
  .dcard__tag:not([class*="chip--"]) {
    background: var(--surface-3);
    border-color: var(--border);
    color: var(--muted);
  }

  .dcard__title {
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 6px;
  }

  .dcard__summary {
    font-size: 14px;
    line-height: 1.55;
    color: var(--faint);
  }

  .browse__empty {
    margin: 32px 0 0;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
  }

  /* Foot ------------------------------------------------------------------ */
  .hub__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--border-soft);
  }

  @media (max-width: 860px) {
    .start__steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .step:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .start__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
