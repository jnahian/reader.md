---
import { faqsHighlight } from "../data/content";
---

{/* `name` makes the group an exclusive accordion with no JS at all. The script
    below removes it, because animating the close of a sibling needs that
    sibling to stay open until its animation ends — which a named group
    forbids. */}
<section class="faq">
  <div class="faq__inner">
    <div class="reveal">
      <div class="eyebrow">QUESTIONS</div>
      <h2 class="faq__title">Before you download.</h2>
    </div>

    <div class="faq__list reveal" style="--reveal-delay:.1s" data-faq>
      {
        faqsHighlight.map((f) => (
          <details class="faq__item" name="faq">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__mark" aria-hidden="true" />
            </summary>
            <div class="faq__panel">
              <div class="faq__a" set:html={f.a} />
            </div>
          </details>
        ))
      }
    </div>

    <a href="/docs/faq" class="faq__all reveal" style="--reveal-delay:.18s">
      See all questions →
    </a>
  </div>
</section>

<style>
  .faq {
    position: relative;
    z-index: 2;
  }
  .faq__inner {
    max-width: var(--maxw-prose);
    margin: 0 auto;
    padding: 80px var(--pad-x);
    text-align: center;
  }
  .faq__title {
    margin: 0 0 40px;
    font-size: clamp(28px, 3.6vw, 44px);
  }
  .faq__list {
    text-align: left;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    overflow: hidden;
  }
  .faq__item + .faq__item {
    border-top: 1px solid var(--border-soft);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    cursor: pointer;
    font-size: 16.5px;
    font-weight: 500;
    color: var(--fg);
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    background: var(--surface-2);
  }
  /* A plus that turns into a cross, so the control reads the same closed or
     open without a second glyph. */
  .faq__mark {
    position: relative;
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--faint);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), color 0.28s ease;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: "";
    position: absolute;
    inset: 50% 0;
    border-top: 1.5px solid currentColor;
  }
  .faq__mark::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__mark {
    transform: rotate(45deg);
    color: var(--fg);
  }
  /* The element the script animates the height of; clipping is what makes the
     slide read as a slide rather than a fade. */
  .faq__panel {
    overflow: hidden;
  }
  .faq__a {
    padding: 0 56px 22px 24px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
  }
  .faq__all {
    display: inline-block;
    margin-top: 24px;
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__mark {
      transition: none;
    }
  }
</style>

<script>
  import { initAccordion } from "../scripts/accordion";

  document
    .querySelectorAll("[data-faq]")
    .forEach((list) => initAccordion(list, { exclusive: true }));
</script>
