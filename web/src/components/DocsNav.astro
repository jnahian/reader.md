---
import { getCollection } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  current: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { current, headings } = Astro.props;

const pages = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order
);

// Same grouping rule as the /docs hub: a category sits where its lowest-ordered
// page does, so frontmatter stays the only place ordering is decided.
const groups: { name: string; pages: typeof pages }[] = [];
for (const page of pages) {
  const group = groups.find((g) => g.name === page.data.category);
  if (group) group.pages.push(page);
  else groups.push({ name: page.data.category, pages: [page] });
}

// Only h2s — h3s make the rail noisy on long pages.
const toc = headings.filter((h) => h.depth === 2);

// Names the page you are on while the rail is collapsed, so the closed control
// still says where you are.
const currentTitle = pages.find((p) => p.id === current)?.data.title ?? "Docs";
---

{/* Below 900px the rail is a stacked block, and every page opened with a
    fourteen-page index plus this page's own sections above the first
    paragraph. There it collapses into one sticky control instead. */}
<aside class="docsnav" data-docsnav>
  <button
    type="button"
    class="docsnav__toggle"
    data-docsnav-toggle
    aria-controls="docsnav-panel"
    aria-expanded="false"
  >
    <Icon name="menu" size={16} />
    <span class="docsnav__toggle-text">
      <span class="docsnav__toggle-label">Docs</span>
      <span class="docsnav__toggle-current">{currentTitle}</span>
    </span>
    <span class="docsnav__chev"><Icon name="chevron" size={16} /></span>
  </button>

  <div class="docsnav__panel" id="docsnav-panel">
    <nav class="docsnav__pages">
      <a href="/docs" class="docsnav__link">← All docs</a>
    </nav>
    {/* This page's own sections first: they are what a reader wants while
        reading, and the list of every other page is what they want after. */}
    {toc.length > 0 && (
      <>
        <div class="docsnav__label">ON THIS PAGE</div>
        <nav class="docsnav__toc">
          {toc.map((h) => (
            <a href={`#${h.slug}`} class="docsnav__sublink" data-spy={h.slug}>{h.text}</a>
          ))}
        </nav>
      </>
    )}

    {groups.map((group) => (
      <>
        <div class="docsnav__label">{group.name}</div>
        <nav class="docsnav__pages">
          {group.pages.map((p) => (
            <a
              href={`/docs/${p.id}`}
              class:list={["docsnav__link", { "is-active": p.id === current }]}
            >
              {p.data.title}
            </a>
          ))}
        </nav>
      </>
    ))}
  </div>
</aside>

<script is:inline>
  // Inline so the rail is collapsed before first paint, and so it stays
  // expanded — the markup's own state — if the script never runs.
  (() => {
    const rail = document.querySelector("[data-docsnav]");
    const toggle = rail && rail.querySelector("[data-docsnav-toggle]");
    if (!rail || !toggle) return;

    rail.classList.add("docsnav--js");

    const close = () => {
      rail.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", () => {
      const open = rail.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    });

    // The section links only move the hash, so nothing else would close it.
    rail.querySelectorAll("#docsnav-panel a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => e.key === "Escape" && close());
    document.addEventListener("click", (e) => {
      if (!rail.contains(e.target)) close();
    });
    window.matchMedia("(min-width: 901px)").addEventListener("change", close);
  })();
</script>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-spy]"));
  const setActive = (id: string) => {
    links.forEach((a) => a.classList.toggle("is-active", a.dataset.spy === id));
  };
  const sections = document.querySelectorAll<HTMLElement>(".doc__body h2[id]");
  if (links.length && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-90px 0px -65% 0px", threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
    setActive(sections[0].id);
  }
</script>

<style>
  .docsnav {
    position: sticky;
    top: 92px;
    align-self: start;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .docsnav__panel {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .docsnav__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 22px 0 8px;
  }

  /* The page list is a different kind of navigation from this page's own
     sections, so it gets a wider gap above it than one category does. */
  .docsnav__toc + .docsnav__label {
    margin-top: 30px;
  }

  .docsnav__pages,
  .docsnav__toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Radii are literals throughout global.css rather than tokens; these match
     the small-control values already used there. */
  .docsnav__link,
  .docsnav__sublink {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    padding: 6px 10px;
    border-radius: 7px;
    line-height: 1.35;
  }

  .docsnav__sublink {
    font-size: 13px;
    padding-left: 18px;
  }

  .docsnav__link:hover,
  .docsnav__sublink:hover {
    color: var(--fg);
  }

  .docsnav__link.is-active,
  .docsnav__sublink.is-active {
    color: var(--fg);
    background: var(--surface);
  }

  /* Collapsed rail -------------------------------------------------------- */
  .docsnav__toggle {
    display: none;
    width: 100%;
    align-items: center;
    gap: 11px;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    /* Nearly opaque, not glass: it parks over screenshots and code blocks, and
       a light backdrop showed straight through a lower alpha. */
    background: rgba(10, 11, 14, 0.95);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    color: var(--muted);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .docsnav__toggle-text {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .docsnav__toggle-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .docsnav__toggle-current {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .docsnav__chev {
    display: flex;
    color: var(--faint);
    transition: transform 0.2s ease;
  }
  .docsnav.is-open .docsnav__chev {
    transform: rotate(180deg);
  }

  @media (max-width: 900px) {
    /* Without the script this stays the full list stacked above the article —
       long, but every link works. Everything below is the collapsed version,
       so it only applies once the script has run. */
    .docsnav {
      position: static;
      max-height: none;
      margin-bottom: 28px;
    }

    /* Sticky needs a block container: as a grid item the rail could only
       travel inside its own (toggle-height) row and would never move.
       pages/docs/[...slug].astro stacks .doc with `display: block` here. */
    .docsnav--js {
      position: sticky;
      top: var(--nav-stick);
      z-index: 20;
      overflow: visible;
    }

    .docsnav--js .docsnav__toggle {
      display: flex;
    }

    /* Overlaid rather than pushed in, so opening the index does not shove the
       paragraph you were reading down the page. */
    .docsnav--js .docsnav__panel {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      max-height: min(66vh, 520px);
      overflow-y: auto;
      padding: 6px 12px 14px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--bg);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55);
    }

    .docsnav--js.is-open .docsnav__panel {
      display: flex;
      animation: railDrop 0.18s ease;
    }

    /* Roomier rows: these are thumb targets in the panel, not pointer targets
       in a rail. */
    .docsnav--js .docsnav__link,
    .docsnav--js .docsnav__sublink {
      padding: 9px 10px;
    }
  }

  @keyframes railDrop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
