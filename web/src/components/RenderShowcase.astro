---
// "Diagrams, math & code that render" — dark-mode app screenshot + copy.
const tags = ["Code copy buttons", "Image lightbox", "Heading anchors"];
---

<section class="showcase container reveal">
  <div class="showcase__panel showcase__panel--purple">
    <div class="showcase__shot">
      <img
        src="/screenshots/rendering-showcase/01-rendering.png"
        width="2400"
        height="2160"
        alt="Reader.md rendering a vertical Mermaid flowchart and a KaTeX equation in the same document"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="showcase__copy">
      <div class="eyebrow eyebrow--purple">RENDERING</div>
      <h2 class="showcase__title">Diagrams, math &amp; code that render.</h2>
      <p class="showcase__lead">
        The content pane is a <code class="tok">WKWebView</code> driven by bundled marked, Mermaid,
        KaTeX, and highlight.js — the exact things a native text view can't do. YAML frontmatter
        renders as a clean key/value table, and everything works fully offline.
      </p>
      <div class="showcase__tags">
        {tags.map((t) => <span class="showcase__tag">{t}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: 56px;
  }
  .showcase__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
    border-radius: 24px;
    padding: clamp(28px, 5vw, 56px);
    border: 1px solid var(--border);
  }
  .showcase__panel--purple {
    background: linear-gradient(150deg, oklch(0.72 0.16 260 / 0.1), rgba(255, 255, 255, 0.02));
  }
  .eyebrow--purple {
    color: var(--purple-text);
  }
  .showcase__title {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.1;
  }
  .showcase__lead {
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }
  .showcase__tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .showcase__tag {
    padding: 8px 14px;
    border-radius: 9px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 13px;
  }

  /* dark app screenshot */
  .showcase__shot {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 26px 64px rgba(0, 0, 0, 0.5);
  }
  .showcase__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 820px) {
    .showcase__panel {
      grid-template-columns: 1fr;
    }
    .showcase__shot {
      order: 2;
    }
  }
</style>
