---
// An icon-only copy button on every code block in a docs page or use case. The
// blocks are rendered markdown, so the button is cloned in from a template
// rather than written into each one.
import Icon from "./Icon.astro";
---

<template id="copy-code">
  <button type="button" class="copycode" aria-label="Copy" title="Copy">
    <Icon name="copy" size={14} />
    <Icon name="check" size={14} />
  </button>
</template>

<script>
  const RESET = 2000;
  const template = document.querySelector<HTMLTemplateElement>("#copy-code");

  document.querySelectorAll<HTMLPreElement>(".doc__body pre").forEach((pre) => {
    if (!template) return;
    // Wrapped so the button stays put while a long line scrolls the block.
    const wrap = document.createElement("div");
    wrap.className = "copycode-wrap";
    pre.replaceWith(wrap);
    wrap.append(pre, template.content.cloneNode(true));

    const button = wrap.querySelector<HTMLButtonElement>(".copycode")!;
    let timer = 0;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
      } catch {
        return;
      }
      button.classList.add("is-copied");
      button.setAttribute("aria-label", "Copied");
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.classList.remove("is-copied");
        button.setAttribute("aria-label", "Copy");
      }, RESET);
    });
  });
</script>

<style is:global>
  .copycode-wrap {
    position: relative;
  }

  .copycode-wrap pre {
    padding-right: 52px;
  }

  .copycode {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .copycode:hover {
    color: var(--fg);
    background: var(--surface-3);
  }

  .copycode.is-copied {
    color: var(--cyan);
    border-color: color-mix(in oklch, var(--cyan) 40%, transparent);
  }

  .copycode .icon:nth-of-type(2),
  .copycode.is-copied .icon:nth-of-type(1) {
    display: none;
  }
  .copycode.is-copied .icon:nth-of-type(2) {
    display: inline;
  }
</style>
